<Window x:Class="MirrorCast.Receiver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="MirrorCast Receiver" Height="780" Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="#0A1322"
        Icon="logo.ico"
        FontFamily="Segoe UI, Roboto, sans-serif">

    <Window.Resources>
        <!-- Converters -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Sidebar Navigation Button Styles -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1E293B" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActiveNavButtonStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Setter Property="Background" Value="#1B6EF3" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Standard Button Styles -->
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Background" Value="#1B6EF3" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="20" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1557C0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#1B6EF3" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="#1B6EF3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="20" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EFF6FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerOutlineButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#EF4444" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="#EF4444" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="20" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FEE2E2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ControlToolButton" TargetType="Button">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#334155" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavKeyButton" TargetType="Button">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1B6EF3" />
                                <Setter Property="BorderBrush" Value="#1B6EF3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- White Card Panel Style -->
        <Style x:Key="CardPanel" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="24" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Dark Sidebar -->
            <ColumnDefinition Width="220" />
            <!-- Main Content Area -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== LEFT DARK SIDEBAR ==================== -->
        <Border Grid.Column="0" Background="#0A1322">
            <Grid Margin="16,24,16,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Logo & Brand Header -->
                <StackPanel Grid.Row="0" Margin="4,0,0,32">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="logo.ico" Width="32" Height="32" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="MirrorCast" FontSize="19" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Mirror Your Android Screen" FontSize="11" Foreground="#64748B" Margin="42,2,0,0" />
                    <TextBlock Text="by 0xSHARON" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8" Margin="42,2,0,0" Cursor="Hand" MouseLeftButtonUp="OnOpenAuthorProfileClick" ToolTip="Open 0xSHARON on GitHub" />
                </StackPanel>

                <!-- Navigation Menu -->
                <StackPanel Grid.Row="1">
                    <Button x:Name="NavHome" Content="🏠   Home" Style="{StaticResource ActiveNavButtonStyle}" Tag="Home" Click="OnNavClick" />
                    <Button x:Name="NavConnections" Content="📶   Connections" Style="{StaticResource NavButtonStyle}" Tag="Connections" Click="OnNavClick" />
                    <Button x:Name="NavSettings" Content="⚙️   Settings" Style="{StaticResource NavButtonStyle}" Tag="Settings" Click="OnNavClick" />
                    <Button x:Name="NavLogs" Content="📋   Logs" Style="{StaticResource NavButtonStyle}" Tag="Logs" Click="OnNavClick" />
                    <Button x:Name="NavAbout" Content="ℹ️   About" Style="{StaticResource NavButtonStyle}" Tag="About" Click="OnNavClick" />
                </StackPanel>

                <!-- Stop Receiver / Bottom Action -->
                <Button Grid.Row="2" Content="⏹   Stop Receiver" Style="{StaticResource DangerOutlineButton}" Click="OnStopReceiverClick" />
            </Grid>
        </Border>

        <!-- ==================== RIGHT MAIN CONTENT ==================== -->
        <Grid Grid.Column="1" Background="#F4F6F9">

            <!-- ==================== VIEW 1: HOME (LISTENING STATE) ==================== -->
            <Grid Margin="32" Visibility="{Binding IsHomeListening, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top Status Banner -->
                <Border Grid.Row="0" Style="{StaticResource CardPanel}" Margin="0,0,0,24" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#DCFCE7" Margin="0,0,16,0">
                            <TextBlock Text="✓" FontSize="22" FontWeight="Bold" Foreground="#16A34A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Receiver is Running" FontSize="18" FontWeight="Bold" Foreground="#0F172A" />
                            <TextBlock Text="Your PC is ready to receive connections over Wi-Fi and USB" FontSize="13" Foreground="#64748B" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Connection Mode Chips -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#EFF6FF" CornerRadius="16" Padding="12,6" Margin="0,0,8,0">
                                <TextBlock Text="📶 Wi-Fi Ready" FontSize="12" FontWeight="SemiBold" Foreground="#1D4ED8" />
                            </Border>
                            <Border Background="#F1F5F9" CornerRadius="16" Padding="12,6">
                                <TextBlock Text="🔌 USB (ADB) Ready" FontSize="12" FontWeight="SemiBold" Foreground="#475569" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Center 2 Columns: Pairing Code & QR Code -->
                <Grid Grid.Row="1" Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Card: Pairing Code (4 Big Digits) -->
                    <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Pairing Code" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Center" />

                            <!-- 4 Digit Boxes -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="56" Height="68" CornerRadius="12" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.5" Margin="6,0">
                                    <TextBlock Text="{Binding PinDigit1}" FontSize="32" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border Width="56" Height="68" CornerRadius="12" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.5" Margin="6,0">
                                    <TextBlock Text="{Binding PinDigit2}" FontSize="32" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border Width="56" Height="68" CornerRadius="12" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.5" Margin="6,0">
                                    <TextBlock Text="{Binding PinDigit3}" FontSize="32" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border Width="56" Height="68" CornerRadius="12" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.5" Margin="6,0">
                                    <TextBlock Text="{Binding PinDigit4}" FontSize="32" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>

                            <Button Grid.Row="2" Content="🔄   Regenerate Code" Style="{StaticResource OutlineButton}" HorizontalAlignment="Center" Click="OnRegeneratePinClick" />
                        </Grid>
                    </Border>

                    <!-- Right Card: QR Code -->
                    <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Scan QR Code" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Center" />

                            <!-- QR Image Container -->
                            <Border Grid.Row="1" Width="160" Height="160" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="8">
                                <Image Source="{Binding QrCodeImage}" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            </Border>

                            <TextBlock Grid.Row="2" Text="Scan this code in the Android app to pair automatically" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" TextAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- Bottom Row: Connection Info Bar -->
                <Border Grid.Row="2" Style="{StaticResource CardPanel}" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📶" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <StackPanel>
                                <TextBlock Text="Connection Info" FontSize="14" FontWeight="Bold" Foreground="#0F172A" />
                                <TextBlock Text="Local IP &amp; Port for manual Wi-Fi or USB connection" FontSize="12" Foreground="#64748B" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="IP Address" FontSize="11" Foreground="#64748B" />
                                <TextBlock Text="{Binding LocalIpAddress}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Port" FontSize="11" Foreground="#64748B" />
                                <TextBlock Text="{Binding Port}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Copy IP Address Button -->
                        <Button Grid.Column="2" Content="📋   Copy IP Address" Style="{StaticResource OutlineButton}" Click="OnCopyIpClick" />
                    </Grid>
                </Border>
            </Grid>

            <!-- ==================== VIEW 2: HOME (MIRRORING STATE) ==================== -->
            <Grid Visibility="{Binding IsMirroring, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <!-- Top Status Bar -->
                    <RowDefinition Height="52" />
                    <!-- Video Canvas + Right Controls -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Top Streaming Status Bar -->
                <Border Grid.Row="0" Background="#0A1322" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="20,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Fill="#22C55E" Margin="0,0,10,0" />
                            <TextBlock Text="Connected: " FontSize="14" Foreground="#94A3B8" />
                            <TextBlock Text="{Binding ConnectedDeviceName}" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding LocalIpAddress}" FontSize="13" Foreground="#64748B" Margin="0,0,16,0" />
                            <Border Background="#1E293B" CornerRadius="4" Padding="8,2">
                                <TextBlock Text="{Binding StreamDuration}" FontSize="13" FontWeight="SemiBold" Foreground="#38BDF8" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Video Viewport & Controls Side-by-Side -->
                <Grid Grid.Row="1" Margin="24">
                    <Grid.ColumnDefinitions>
                        <!-- Center Video Canvas -->
                        <ColumnDefinition Width="*" />
                        <!-- Right Controls & Info Panel -->
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>

                    <!-- Phone Mirror Canvas + Phone Control Bar -->
                    <Grid Grid.Column="0" Margin="0,0,24,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#0D1117" CornerRadius="16" BorderBrush="#1E293B" BorderThickness="1.5" ClipToBounds="True">
                            <Grid>
                                <wv2:WebView2 x:Name="VideoWebView" />
                            </Grid>
                        </Border>

                        <!-- Device Navigation Toolbar (Control Phone from PC) -->
                        <Border Grid.Row="1" Background="#0A1322" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="12" Margin="0,12,0,0" Padding="12,8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="◀   Back" Style="{StaticResource NavKeyButton}" Click="OnBackClick" />
                                <Button Content="⚪   Home" Style="{StaticResource NavKeyButton}" Click="OnHomeClick" />
                                <Button Content="▢   Recents" Style="{StaticResource NavKeyButton}" Click="OnRecentsClick" />
                                <Button Content="🔊   Vol +" Style="{StaticResource NavKeyButton}" Click="OnVolUpClick" />
                                <Button Content="🔉   Vol -" Style="{StaticResource NavKeyButton}" Click="OnVolDownClick" />
                                <Button Content="🔒   Power" Style="{StaticResource NavKeyButton}" Click="OnPowerClick" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Right Controls Panel -->
                    <StackPanel Grid.Column="1">
                        <!-- Stream Info Card -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Stream Info" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,14" />

                                <Grid Margin="0,4">
                                    <TextBlock Text="Resolution" FontSize="12" Foreground="#64748B" />
                                    <TextBlock Text="{Binding StreamResolution}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,4">
                                    <TextBlock Text="Frame Rate" FontSize="12" Foreground="#64748B" />
                                    <TextBlock Text="{Binding StreamFps, StringFormat='{}{0:F0} fps'}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,4">
                                    <TextBlock Text="Latency" FontSize="12" Foreground="#64748B" />
                                    <TextBlock Text="~15 ms" FontSize="12" FontWeight="SemiBold" Foreground="#16A34A" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,4">
                                    <TextBlock Text="Bitrate" FontSize="12" Foreground="#64748B" />
                                    <TextBlock Text="{Binding StreamBitrateMbps, StringFormat='{}{0:F1} Mbps'}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Controls Card -->
                        <Border Style="{StaticResource CardPanel}" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Controls" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12" />

                                <Button Content="⛶   Full Screen" Style="{StaticResource ControlToolButton}" Click="OnFullScreenClick" />
                                <Button Content="⛶   Fit to Window" Style="{StaticResource ControlToolButton}" Click="OnToggleFitClick" />
                                <Button Content="⟳   Rotate 90°" Style="{StaticResource ControlToolButton}" Click="OnRotateClick" />
                                <Button Content="📸   Screenshot" Style="{StaticResource ControlToolButton}" Click="OnScreenshotClick" />

                                <Border Height="1" Background="#E2E8F0" Margin="0,12" />

                                <Button Content="✕   Disconnect" Style="{StaticResource DangerOutlineButton}" HorizontalAlignment="Stretch" Click="OnDisconnectClick" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ==================== VIEW 3: CONNECTIONS TAB ==================== -->
            <Grid Margin="32" Visibility="{Binding IsConnectionsTab, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Network &amp; Connections" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,6" />
                    <TextBlock Text="Manage active Wi-Fi, USB ADB, and port forwarding tunnels" FontSize="13" Foreground="#64748B" Margin="0,0,0,24" />

                    <!-- Interfaces Card -->
                    <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Network Interfaces" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12" />
                            <Grid Margin="0,6">
                                <TextBlock Text="Local Wi-Fi IP Address" FontSize="13" Foreground="#64748B" />
                                <TextBlock Text="{Binding LocalIpAddress}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,6">
                                <TextBlock Text="Signaling &amp; WebRTC Port" FontSize="13" Foreground="#64748B" />
                                <TextBlock Text="{Binding Port}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,6">
                                <TextBlock Text="UDP Subnet Discovery Beacon" FontSize="13" Foreground="#64748B" />
                                <TextBlock Text="Port 8091 (Active)" FontSize="13" FontWeight="SemiBold" Foreground="#16A34A" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,6">
                                <TextBlock Text="USB Loopback Tunnel (ADB)" FontSize="13" Foreground="#64748B" />
                                <TextBlock Text="127.0.0.1:8090 (Ready)" FontSize="13" FontWeight="SemiBold" Foreground="#16A34A" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Firewall & Helper Actions -->
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <TextBlock Text="Connection Utilities" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12" />
                            <TextBlock Text="If your phone cannot find your PC over Wi-Fi, make sure Windows Firewall allows inbound TCP traffic." FontSize="13" Foreground="#64748B" Margin="0,0,0,16" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="🛡️   Configure Windows Firewall" Style="{StaticResource PillButton}" Click="OnFirewallClick" Margin="0,0,12,0" />
                                <Button Content="📋   Copy Connection URL" Style="{StaticResource OutlineButton}" Click="OnCopyIpClick" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ==================== VIEW 4: SETTINGS TAB ==================== -->
            <Grid Margin="32" Visibility="{Binding IsSettingsTab, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Text="Receiver Settings" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,6" />
                        <TextBlock Text="Configure connection authorization, security, remote control, and streaming quality" FontSize="13" Foreground="#64748B" Margin="0,0,0,20" />

                        <!-- Status / Feedback Banner -->
                        <Border Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16" Visibility="{Binding HasSettingsFeedback, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding SettingsFeedback}" FontSize="13" FontWeight="SemiBold" Foreground="#166534" />
                        </Border>

                        <!-- Card 1: Connection Security & Authorization -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Connection Security &amp; Authorization" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,14" />

                                <!-- Setting 1: Require Confirmation Popup -->
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Require Connection Approval Popup" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                                        <TextBlock Text="Show modal on PC when a phone requests to mirror. Mirroring only starts when you click Allow." FontSize="12" Foreground="#64748B" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding RequireConfirmationPopup}" VerticalAlignment="Center" Cursor="Hand" />
                                </Grid>

                                <Border Height="1" Background="#F1F5F9" Margin="0,6" />

                                <!-- Setting 2: Auto-Approve USB -->
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Auto-Approve USB Connections" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                                        <TextBlock Text="Bypasses the confirmation popup only for trusted direct USB cable connections" FontSize="12" Foreground="#64748B" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding AutoApproveUsb}" VerticalAlignment="Center" Cursor="Hand" />
                                </Grid>

                                <Border Height="1" Background="#F1F5F9" Margin="0,6" />

                                <!-- Setting 3: Require PIN Auth -->
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Require 4-Digit PIN Authentication" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                                        <TextBlock Text="Verify matching 4-digit code generated on PC before pairing" FontSize="12" Foreground="#64748B" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding RequirePinAuth}" VerticalAlignment="Center" Cursor="Hand" />
                                </Grid>

                                <Border Height="1" Background="#F1F5F9" Margin="0,6" />

                                <!-- Setting 4: Remote Control -->
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Allow Remote Device Control" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                                        <TextBlock Text="Enables mouse click, drag, and navigation buttons on PC to control your Android device" FontSize="12" Foreground="#64748B" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding EnableRemoteControl}" VerticalAlignment="Center" Cursor="Hand" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Display & Streaming Quality -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Display &amp; Streaming Quality" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,14" />

                                <!-- Setting 5: Fit Video to Window -->
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Fit Video to Window" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                                        <TextBlock Text="Automatically scales and fits the video within the receiver window" FontSize="12" Foreground="#64748B" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding FitToWindow}" VerticalAlignment="Center" Cursor="Hand" />
                                </Grid>

                                <Border Height="1" Background="#F1F5F9" Margin="0,6" />

                                <!-- Setting 6: Server Port -->
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Signaling Server Port" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                                        <TextBlock Text="Port 8090 by default. Receiver will restart if changed." FontSize="12" Foreground="#64748B" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Background="#FFFFFF">
                                            <TextBox Width="70" Height="28" Text="{Binding ConfigPortText, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" Padding="6,2" FontSize="12" />
                                        </Border>
                                        <Button Content="Apply" Style="{StaticResource OutlineButton}" Margin="8,0,0,0" Padding="10,4" Click="OnApplyPortClick" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Button Content="💾   Save Preferences" Style="{StaticResource PillButton}" HorizontalAlignment="Left" Click="OnSaveSettingsClick" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ==================== VIEW 5: LOGS TAB ==================== -->
            <Grid Margin="32" Visibility="{Binding IsLogsTab, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Diagnostic Logs" FontSize="22" FontWeight="Bold" Foreground="#0F172A" />
                        <TextBlock Text="Real-time signaling, WebRTC negotiation, and device control traces" FontSize="13" Foreground="#64748B" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="📋   Copy" Style="{StaticResource OutlineButton}" Click="OnCopyLogsClick" Margin="0,0,8,0" />
                        <Button Content="🗑️   Clear" Style="{StaticResource DangerOutlineButton}" Click="OnClearLogsClick" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="#0F172A" CornerRadius="12" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding LogsText}" FontFamily="Consolas, monospace" FontSize="12" Foreground="#38BDF8" TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ==================== VIEW 6: ABOUT TAB ==================== -->
            <Grid Margin="32" Visibility="{Binding IsAboutTab, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="80" Height="80" CornerRadius="20" Background="#EFF6FF" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Image Source="logo.ico" Width="52" Height="52" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>

                    <TextBlock Text="MirrorCast Receiver" FontSize="26" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" />
                    <TextBlock Text="Version 1.0.0" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,8" />
                    <TextBlock Text="by 0xSHARON" FontSize="14" FontWeight="Bold" Foreground="#1B6EF3" HorizontalAlignment="Center" Margin="0,0,0,24" Cursor="Hand" MouseLeftButtonUp="OnOpenAuthorProfileClick" ToolTip="Open 0xSHARON on GitHub" />

                    <Border Style="{StaticResource CardPanel}" Width="480" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="MirrorCast is a high-performance, low-latency screen mirroring solution that streams Android screens to Windows PCs using WebRTC, hardware-accelerated H.264 encoding, and remote device control." FontSize="13" Foreground="#475569" TextWrapping="Wrap" LineHeight="20" />
                        </StackPanel>
                    </Border>

                    <Button Content="⭐   View on GitHub" Style="{StaticResource PillButton}" Click="OnOpenGithubClick" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- ==================== VIEW 7: INCOMING CONNECTION REQUEST MODAL ==================== -->
            <Border Background="#80000000" Visibility="{Binding HasIncomingRequest, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Border Style="{StaticResource CardPanel}" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32">
                    <StackPanel HorizontalAlignment="Center">
                        <!-- Bell Icon -->
                        <Border Width="56" Height="56" CornerRadius="28" Background="#EFF6FF" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock Text="🔔" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Text="Incoming Connection Request" FontSize="18" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,0,0,18" />

                        <!-- Device Card -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="📱" FontSize="28" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Android Device" FontSize="11" Foreground="#64748B" />
                                    <TextBlock Text="{Binding IncomingDeviceName}" FontSize="15" FontWeight="Bold" Foreground="#0F172A" />
                                    <TextBlock Text="{Binding IncomingDeviceIp, StringFormat='IP Address: {0}'}" FontSize="12" Foreground="#64748B" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="This device wants to mirror its screen to your PC. Do you want to allow the connection?" FontSize="13" Foreground="#475569" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,24" />

                        <!-- Action Buttons -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Allow" Style="{StaticResource PillButton}" Click="OnAllowClick" />
                            <Button Grid.Column="2" Content="Reject" Style="{StaticResource DangerOutlineButton}" Click="OnRejectClick" />
                        </Grid>

                        <CheckBox Content="Remember this device" Foreground="#64748B" FontSize="12" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Border>

        </Grid>
    </Grid>
</Window>
