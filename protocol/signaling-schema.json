{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MirrorCastSignalingMessage",
  "description": "Standardized WebSocket Signaling Protocol Schema for MirrorCast",
  "type": "object",
  "required": ["version", "type"],
  "properties": {
    "version": {
      "type": "string",
      "enum": ["1.0"]
    },
    "type": {
      "type": "string",
      "enum": [
        "discover",
        "pair_request",
        "pair_response",
        "offer",
        "answer",
        "ice_candidate",
        "control",
        "stats",
        "disconnect",
        "error"
      ]
    },
    "sessionId": {
      "type": "string",
      "description": "Unique session token issued upon pairing approval"
    },
    "payload": {
      "type": "object",
      "description": "Type-specific message payload"
    }
  }
}
